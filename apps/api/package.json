{
  "name": "@plateraa/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@node-rs/argon2": "2.2.1",
    "@plateraa/db": "workspace:*",
    "@plateraa/shared": "workspace:*",
    "better-auth": "1.7.4",
    "jose": "6.2.12",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.4",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.0"
  }
}
