# Copy to .env and fill in. Never commit .env.

# Neon Postgres (AWS eu-central-1 / Frankfurt). In Neon: project dashboard → Connect.
# Pooled connection: "Connection pooling" ON (the host contains "-pooler"). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct connection: "Connection pooling" OFF. Used for migrations and the pg-boss job worker.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# The two above are the Neon "dev" branch (Render also uses it during development, and tests
# may write to it). The "production" branch, kept for the pilot, goes below: used only by
# `db:migrate:production` and setup scripts run with --production. Tests refuse to run on it.
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_URL_DIRECT=
# The Neon "test" branch (created from "dev"), for the automated tests only. They're brought up
# to the latest migration before each run, and skip when these are empty (as in CI).
TEST_DATABASE_URL=
TEST_DATABASE_URL_DIRECT=

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Better Auth (owner/manager email logins).
BETTER_AUTH_SECRET=
# Public URL of the API.
BETTER_AUTH_URL=http://localhost:3000

# Signs the 15-minute PIN session tokens for the phone app.
SESSION_SIGNING_SECRET=

# Dashboard (apps/dashboard): the API it talks to. Empty means the deployed API on Render; set
# http://localhost:3000 to use an API running on this laptop. Anything starting VITE_ ends up in
# the dashboard's public code, so never put a secret in one.
VITE_API_URL=

# Payment links (plan.md §2.5). Each vendor's own Moolre account is saved per business with
#   pnpm --filter @plateraa/api settings:moolre-account "<business>"
# Moolre's API: https://api.moolre.com. Keys made at app.moolre.com are live keys; the sandbox
# (https://sandbox.moolre.com) only knows its own test accounts, and answers "user not found".
MOOLRE_BASE_URL=https://api.moolre.com
# Encrypts each vendor's Moolre key at rest (generate like the secrets above). Keep it safe:
# losing it means entering every vendor's key again.
SECRETS_KEY=
# Our Moolre SMS account, which texts the links, and its approved sender name (max 11 chars).
MOOLRE_SMS_VASKEY=
MOOLRE_SMS_SENDER_ID=
# How long a link stays open, in minutes.
PAYMENT_LINK_MINUTES=60
# Only the deployed API makes, texts and checks links. Leave false on a laptop: it shares the
# database, and must never pick up real customers' links.
RUN_PAYMENT_LINKS=false
# Work out finished days' reports ahead of time, every hour. Safe anywhere (reports fill in
# missing days themselves when read); true on the deployed API just makes them quicker to open.
RUN_DAILY_REPORTS=false

# The online store (apps/storefront, plan.md §4.0): its address, for the store link and QR code
# owners share. The Vercel address until plateraa.com is bought.
STOREFRONT_URL=http://localhost:3001

# Cloudflare R2: menu and store photos (bucket plateraa-photos). The key is an R2 API token with
# Object Read & Write on this bucket only. The public address is the bucket's r2.dev address for
# now, and photos.plateraa.com once the domain is bought.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=plateraa-photos
R2_PUBLIC_URL=

# Laptop only: a Render API key, to check the deployed API's deploys and build logs.
RENDER_API_KEY=

# A vendor's own Moolre account, only while running settings:moolre-account (above); empty them
# again afterwards. Only the public key: Plateraa never needs a vendor's private key.
MOOLRE_VENDOR_USER=
MOOLRE_VENDOR_PUBKEY=
MOOLRE_VENDOR_ACCOUNT=
MOOLRE_VENDOR_EMAIL=

# Landing site photos: an Unsplash developer app's Access Key, used only on the laptop to search for photos.
UNSPLASH_ACCESS_KEY=
