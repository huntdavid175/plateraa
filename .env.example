# Copy to .env and fill in. Never commit .env.

# Neon Postgres (AWS eu-central-1 / Frankfurt). In Neon: project dashboard → Connect.
# Pooled connection: "Connection pooling" ON (the host contains "-pooler"). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct connection: "Connection pooling" OFF. Used for migrations and the pg-boss job worker.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# On the laptop, the two above are the Neon "dev" branch, which tests may write to and delete
# from. The live database (Render's) goes here, used only by `db:migrate:production` and by
# setup scripts run with --production. Tests refuse to run if DATABASE_URL is the live one.
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_URL_DIRECT=

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Better Auth (owner/manager email logins).
BETTER_AUTH_SECRET=
# Public URL of the API.
BETTER_AUTH_URL=http://localhost:3000

# Signs the 15-minute PIN session tokens for the phone app.
SESSION_SIGNING_SECRET=

# Payment links (plan.md §2.5). Each vendor's own Moolre account is saved per business with
#   pnpm --filter @plateraa/api settings:moolre-account "<business>"
# Moolre's API: https://api.moolre.com. Keys made at app.moolre.com are live keys; the sandbox
# (https://sandbox.moolre.com) only knows its own test accounts, and answers "user not found".
MOOLRE_BASE_URL=https://api.moolre.com
# Encrypts each vendor's Moolre key at rest (generate like the secrets above). Keep it safe:
# losing it means entering every vendor's key again.
SECRETS_KEY=
# Our Moolre SMS account, which texts the links, and its approved sender name (max 11 chars).
MOOLRE_SMS_VASKEY=
MOOLRE_SMS_SENDER_ID=
# How long a link stays open, in minutes.
PAYMENT_LINK_MINUTES=60
# Only the deployed API makes, texts and checks links. Leave false on a laptop: it shares the
# database, and must never pick up real customers' links.
RUN_PAYMENT_LINKS=false

# A vendor's own Moolre account, only while running settings:moolre-account (above); empty them
# again afterwards. Only the public key: Plateraa never needs a vendor's private key.
MOOLRE_VENDOR_USER=
MOOLRE_VENDOR_PUBKEY=
MOOLRE_VENDOR_ACCOUNT=
MOOLRE_VENDOR_EMAIL=
