# Copy to .env and fill in. Never commit .env.

# Neon Postgres (AWS eu-central-1 / Frankfurt). In Neon: project dashboard → Connect.
# Pooled connection: "Connection pooling" ON (the host contains "-pooler"). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct connection: "Connection pooling" OFF. Used for migrations and the pg-boss job worker.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Better Auth (owner/manager email logins).
BETTER_AUTH_SECRET=
# Public URL of the API.
BETTER_AUTH_URL=http://localhost:3000

# Signs the 15-minute PIN session tokens for the phone app.
SESSION_SIGNING_SECRET=
